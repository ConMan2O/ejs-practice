<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <!-- Include Partials -->
    <%- include('partials/header') %>
    <main>
        <h1>EJS Practice</h1>

        <h2>Hello, <%= person.name %></h2>

        <h3>Your occupation is: <%= person.occupation %></h3>

        <h4>Your Favorite Color is: <%= person.favoriteColor %></h4>

        <% if (person.favoriteColor === 'blue') { %>
            <p>My favorite color is also blue!</p>
        <% } else { %>
            <p>That's an interesting color!</p>
        <% } %>
    </main>
<%- include('partials/footer') %>
</body>
</html>